{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "dom"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "node"],
    "paths": {
      "@/*": ["../../*"]
    },
    "baseUrl": "."
  },
  "include": ["index.ts", "worker-configuration.d.ts", "../../types/next-auth.d.ts"]
}
