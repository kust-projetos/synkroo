# ============================================
# Synkroo - Environment Variables
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://jlkifrngxxayjrfunuuz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Authentication
JWT_SECRET=your-jwt-secret

# MiniMax LLM (for chat/classification)
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_URL=https://api.minimax.io/v1/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-M2.7

# ============================================
# EMBEDDINGS - Choose ONE option below
# ============================================

# Option 1: Jina AI (FREE tier: 1M tokens/month)
# Get your key at: https://jina.ai/embeddings/
JINA_API_KEY=your-jina-api-key

# Option 2: HuggingFace Inference (FREE tier available)
# Get your key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your-hf-api-key

# Option 3: Ollama (FREE, local)
# Install: https://ollama.ai/
# Run: ollama pull nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# Option 4: OpenAI (Paid - best quality)
OPENAI_API_KEY=sk-xxx...
EMBEDDING_MODEL=text-embedding-3-small

# Option 5: Custom embedding provider
# EMBEDDING_API_KEY=your-key
# EMBEDDING_API_URL=https://api.example.com/v1/embeddings
# EMBEDDING_MODEL=your-model

# ============================================
# WhatsApp Integration
# ============================================
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages
WHATSAPP_TOKEN=your-whatsapp-token

# Cron Jobs (Vercel Cron)
CRON_SECRET=your-cron-secret

# Seed endpoint secret
SEED_SECRET=your-seed-secret

# Webhook secret for inbound message verification
WEBHOOK_SECRET=your-webhook-secret

# Application
NODE_ENV=development
PORT=3000
