# ============================================
# Synkroo - Environment Variables
# ============================================

# PostgreSQL / Drizzle (new stack)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=synkroo
POSTGRES_USER=synkroo
POSTGRES_PASSWORD=change-me-local-dev-password
DATABASE_URL=postgresql://synkroo:change-me-local-dev-password@127.0.0.1:55432/synkroo

# Auth.js / JWT
AUTH_SECRET=change-me-with-at-least-32-chars
AUTH_URL=http://localhost:3000
JWT_SECRET=change-me-with-at-least-16-chars

# Supabase (CUTOVER COMPLETE — env vars retained only for scripts that may still reference them)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# MiniMax LLM (for chat/classification)
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_URL=https://api.minimax.io/v1/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-M2.7

# ============================================
# EMBEDDINGS - Choose ONE option below
# ============================================

# Option 1: Jina AI (FREE tier: 1M tokens/month)
JINA_API_KEY=your-jina-api-key

# Option 2: HuggingFace Inference (FREE tier available)
HUGGINGFACE_API_KEY=your-hf-api-key

# Option 3: Ollama (FREE, local)
OLLAMA_HOST=http://localhost:11434

# Option 4: OpenAI (Paid - best quality)
OPENAI_API_KEY=sk-xxx...
EMBEDDING_MODEL=text-embedding-3-small

# WhatsApp Integration
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_ID/messages
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token

# Cron Jobs (Vercel Cron)
CRON_SECRET=your-cron-secret

# Seed endpoint secret
SEED_SECRET=your-seed-secret

# Webhook secret for inbound message verification
WEBHOOK_SECRET=your-webhook-secret

# Application
NODE_ENV=development
PORT=3000
