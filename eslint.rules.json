{
  "extends": ["next/core-web-vitals", "plugin:@typescript-eslint/recommended"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "boundaries"],
  "settings": {
    "boundaries/elements": [
      { "type": "core", "pattern": "src/core/**" },
      { "type": "module", "pattern": "src/modules/*", "capture": ["name"] },
      { "type": "legacy", "pattern": "src/services/*", "capture": ["name"] },
      { "type": "app", "pattern": "src/app/*" },
      { "type": "lib", "pattern": "src/lib/*" }
    ]
  },
  "rules": {
    "no-console": ["warn", {
      "allow": ["warn", "error"]
    }],
    "prefer-const": "error",
    "no-var": "error",
    "react-hooks/exhaustive-deps": "off",
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "off",
    "boundaries/dependencies": ["error", {
      "default": "allow",
      "rules": [
        {
          "from": { "type": "module" },
          "allow": { "to": { "type": ["core", "lib"] } },
          "message": "Módulos só podem depender de Core e libs compartilhadas"
        },
        {
          "from": { "type": "module" },
          "allow": { "to": { "type": "module", "internalPath": "**/index.ts" } },
          "message": "Importe apenas o index.ts de outro módulo"
        },
        {
          "from": { "type": "module" },
          "allow": { "to": { "type": "module", "internalPath": "**/public.ts" } },
          "message": "Cross-module via public.ts permitido"
        },
        {
          "from": { "type": "module" },
          "allow": { "to": { "type": "module", "internalPath": "**/schema/**" } },
          "message": "Cross-module schema permitido"
        }
      ]
    }]
  },
  "overrides": [
    {
      "files": ["src/modules/**/*.{ts,tsx}"],
      "rules": {
        "boundaries/dependencies": ["error", {
          "default": "disallow",
          "rules": [
            {
              "from": { "type": "module" },
              "allow": { "to": { "type": ["core", "lib"] } },
              "message": "Módulos só podem depender de Core e libs compartilhadas"
            },
            {
              "from": { "type": "module" },
              "allow": { "to": { "type": "module", "internalPath": "**/public.ts" } },
              "message": "Cross-module via public.ts permitido"
            },
            {
              "from": { "type": "module" },
              "allow": { "to": { "type": "module", "internalPath": "**/schema/**" } },
              "message": "Cross-module schema permitido"
            }
          ]
        }]
      }
    },
    {
      "files": ["src/services/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["@/modules/*/services", "@/modules/*/services/*", "@/modules/*/repositories", "@/modules/*/repositories/*", "@/modules/*/actions", "@/modules/*/actions/*", "@/modules/*/integrations", "@/modules/*/integrations/*"], "message": "Services só importam módulos via seam público (index.ts/public.ts/schema) — R3" }
          ]
        }],
        "boundaries/dependencies": ["error", {
          "default": "allow",
          "rules": [
            {
              "from": { "type": "legacy" },
              "disallow": { "to": { "type": "module" } },
              "message": "Services só importam módulos via seam público (index.ts, public.ts ou schema/**) — R3"
            },
            {
              "from": { "type": "legacy" },
              "allow": { "to": { "type": "module", "internalPath": "**/index.ts" } },
              "message": "Seam público do módulo (index.ts)"
            },
            {
              "from": { "type": "legacy" },
              "allow": { "to": { "type": "module", "internalPath": "**/public.ts" } },
              "message": "Seam público do módulo (public.ts)"
            },
            {
              "from": { "type": "legacy" },
              "allow": { "to": { "type": "module", "internalPath": "**/schema/**" } },
              "message": "Schema do módulo permitido"
            }
          ]
        }]
      }
    },
    {
      "files": ["src/app/api/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            { "group": ["@/lib/db/schema", "@/lib/db/schema/*"], "message": "Rotas não importam o schema direto. Use tipos de @/lib/db/types ou a camada de módulo/repository." }
          ]
        }]
      }
    },
    {
      "files": ["**/__tests__/**/*.ts", "**/*.test.ts", "**/__tests__/**/*.tsx", "**/*.test.tsx"],
      "rules": {
        "no-console": "off",
        "@typescript-eslint/no-require-imports": "off",
        "boundaries/dependencies": "off",
        "no-restricted-imports": "off",
        "react/display-name": "off"
      }
    },
    {
      "files": ["src/lib/logger.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/components/**/*.{ts,tsx}", "src/app/**/page.tsx", "src/app/**/*.client.tsx"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [
            { "name": "@/lib/db/client", "message": "Componentes não acessam o banco. Use uma Server Action ou route handler." }
          ],
          "patterns": [
            { "group": ["@/lib/db/schema", "@/lib/db/schema/*", "@/repositories/*"], "message": "Acesso a dados só via Action/service no servidor." }
          ]
        }]
      }
    }
  ]
}
