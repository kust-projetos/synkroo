{
  "name": "synkroo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration": "node scripts/seed-test-clinic.mjs && jest --config jest.integration.config.js",
    "test:integration:watch": "jest --config jest.integration.config.js --watch",
    "test:watch": "jest --watch",
    "whatsapp:start": "ts-node src/services/whatsapp/cli.ts",
    "db:setup": "node scripts/setup-db.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "docker compose down && docker volume rm synkroo_postgres_data 2>nul & docker compose up -d --wait",
    "db:seed": "npx tsx scripts/seed-database.ts",
    "db:health": "node scripts/check-db.mjs",
    "seed": "npx tsx scripts/seed-database.ts",
    "health": "curl -s http://localhost:3000/api/health | jq .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:auth": "playwright test --project=unauthenticated",
    "test:e2e:api": "playwright test --project=api",
    "build:cf": "opennextjs-cloudflare build && node scripts/inject-pg-global.mjs",
    "inject:pg": "node scripts/inject-pg-global.mjs .open-next/worker.js",
    "preview:cf": "opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "dev:ia-bridge": "wrangler dev --config wrangler.ia-bridge.jsonc",
    "deploy:ia-bridge": "wrangler deploy --config wrangler.ia-bridge.jsonc",
    "typecheck:ia-bridge": "tsc --noEmit --project src/workers/ia-bridge/tsconfig.json"
  },
  "dependencies": {
    "@event-calendar/core": "^5.6.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.97.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.7.0",
    "next": "^15.1.0",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.0",
    "chromium-bidi": "15.0.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "playwright": "^1.48.0",
    "playwright-extra": "^4.3.6",
    "postcss": "^8.4.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.101.0"
  }
}
